{
  "name": "roco-toolbox",
  "private": true,
  "version": "1.3.2",
  "license": "GPL-3.0-only",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:data-pipeline": "vitest run --config vitest.data-pipeline.config.ts",
    "e2e": "playwright test",
    "test:mother-groups:api": "node tools/test/run-mother-groups-local.mjs",
    "test:mother-groups:live": "node tools/test/run-mother-groups-local.mjs --live",
    "trim:catalog": "node tools/data-pipeline/trim-catalog.mjs",
    "verify": "tsc -b && vitest run && node tools/lint-copy.mjs",
    "deploy:test": "npm run verify && npm run build && wrangler pages deploy dist --project-name roco-toolbox --branch=test --commit-dirty=true",
    "deploy:prod": "npm run verify && npm run build && wrangler pages deploy dist --project-name roco-toolbox --branch=main --commit-dirty=true",
    "desktop": "npm run build && node desktop/prepare-app.mjs && electron desktop/main.cjs",
    "desktop:build": "npm run build && node desktop/prepare-app.mjs && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.localdatatool.toolbox",
    "productName": "洛克工具箱",
    "directories": {
      "output": "release",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/capture/**/*",
      "desktop/overlay/**/*",
      "desktop/app-dist/**/*",
      "package.json",
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/@koromix/**/*"
    ],
    "win": {
      "icon": "desktop/build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "洛克工具箱",
      "artifactName": "洛克工具箱-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "洛克工具箱-${version}-便携版.${ext}"
    }
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "koffi": "^3.3.7",
    "pako": "^2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^26.6.2",
    "@types/pako": "^2.0.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.2",
    "workbox-precaching": "^7.4.1",
    "wrangler": "4.151.3"
  }
}
